# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nosheeet

# ─── Redis ───────────────────────────────────────────────────────────────────
# Redis connection string for BullMQ queues
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────────────────────────
# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=change-me-in-production

# ─── Google OAuth 2.0 ────────────────────────────────────────────────────────
# Create credentials at console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match exactly what is registered in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# ─── WhatsApp Business Cloud API ─────────────────────────────────────────────
# Any string you choose; configure the same value in Meta Developer portal webhook settings
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
# Permanent token from Meta Developer portal → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
# Phone Number ID from Meta Developer portal → WhatsApp → Phone Numbers
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# ─── Anthropic ───────────────────────────────────────────────────────────────
# Get your key at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of additional allowed origins (beyond localhost:* and *.lovable.app)
# Example: https://app.nosheeet.com,https://www.nosheeet.com
ALLOWED_ORIGINS=

# ─── App ─────────────────────────────────────────────────────────────────────
# Port the Express server listens on
PORT=3001
# URL of the frontend — used for CORS and OAuth redirect after login
FRONTEND_URL=http://localhost:5173
# Set to 'production' in prod (disables mock OTP, enables stricter checks)
NODE_ENV=development
