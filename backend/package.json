{
  "name": "nosheeet-backend",
  "version": "1.0.0",
  "description": "NoSheeet CRM Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "node -e \"require('dotenv').config(); const { Pool } = require('pg'); const fs = require('fs'); const pool = new Pool({ connectionString: process.env.DATABASE_URL }); pool.query(fs.readFileSync('src/db/schema.sql','utf8')).then(() => pool.query(fs.readFileSync('src/db/migrate.sql','utf8'))).then(() => { console.log('Migration complete'); pool.end(); }).catch(e => { console.error(e); pool.end(); process.exit(1); })\"",
    "test": "NODE_OPTIONS='--max-old-space-size=4096' jest --runInBand",
    "test:unit": "NODE_OPTIONS='--max-old-space-size=4096' jest --runInBand snooze-escalation",
    "test:integration": "NODE_OPTIONS='--max-old-space-size=4096' jest --runInBand --testPathPattern='matcher|merge|reminder-triggers'",
    "test:watch": "NODE_OPTIONS='--max-old-space-size=4096' jest --watch",
    "smoke": "tsx scripts/smoke-test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.3",
    "axios": "^1.7.2",
    "bullmq": "^5.7.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "googleapis": "^140.0.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "jest": "^30.3.0",
    "testcontainers": "^10.0.0",
    "ts-jest": "^29.4.6",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3"
  }
}
